{
  "name": "ai-desktop-kanojo",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop companion app",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "postinstall": "install-electron",
    "test:smoke": "electron scripts/smoke.cjs",
    "test:memory": "node scripts/memory-smoke.cjs",
    "test:settings": "node scripts/settings-smoke.cjs",
    "test:styles": "electron scripts/style-smoke.cjs && electron scripts/style-smoke.cjs --dev",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:character": "electron scripts/character-smoke.cjs",
    "assets:test": "node scripts/generate-test-character.cjs",
    "test:private-mode": "node scripts/private-mode-smoke.cjs",
    "test:events": "node scripts/events-smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
